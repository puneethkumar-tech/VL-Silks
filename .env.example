# VL Silks Environment Configuration Template
FLASK_APP=backend.app:create_app
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=vl-silks-super-secret-key-change-in-production

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=vl_silks_db
TEST_DB_NAME=vl_silks_test_db
DB_USER=root
DB_PASSWORD=your_mysql_password_here

# Optional: SSL/TLS for Cloud MySQL (e.g. Aiven)
# MYSQL_SSL_CA=certs/aiven-ca.pem

# Server Port (optional, Render provides PORT automatically)
# PORT=5000
